# ─────────────────────────────────────────────────────────────
# Salin file ini jadi .env.local lalu isi nilainya.
# Panduan mendapatkan tiap nilai: docs/07-SETUP.md
# JANGAN commit .env.local — file ini satu-satunya yang boleh masuk git.
# ─────────────────────────────────────────────────────────────

# --- Publik (ikut ter-bundle ke browser, jangan isi rahasia di sini) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Database (Supabase → Project Settings → Database → Connection string) ---
# Pakai connection pooler (port 6543) untuk runtime serverless.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Koneksi langsung (port 5432) khusus untuk migrasi.
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Secret petugas & panitia ---
# Generate dengan: openssl rand -base64 32
STAFF_KEY=""
ADMIN_KEY=""

# --- Google Sheets (Service Account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL="padel-bot@nama-project.iam.gserviceaccount.com"
# Private key dari file JSON. Pertahankan \n literal, bungkus dengan tanda kutip ganda.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=""

# --- Anti-spam (Cloudflare Turnstile) ---
TURNSTILE_SECRET_KEY=""

# --- Email e-ticket (opsional, boleh dikosongkan di MVP) ---
RESEND_API_KEY=""
EMAIL_FROM="Padel Cup <tiket@domainkamu.com>"
